{
  "manifest_version": 3,
  "name": "Bulk Delete for ChatGPT Library (Unofficial)",
  "version": "1.0.0",
  "description": "ChatGPT Kitaplık görsellerini toplu olarak Çöp Kutusu'na taşır. Resmi değildir.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
